#############################################################################
# Weathra frontend configuration
#
# Copy to frontend/.env.local and fill in.
#
# Everything here is PUBLIC. A NEXT_PUBLIC_ prefix ships the value in the
# browser bundle, so only the Supabase project URL, its public client key, and
# the backend base URL may appear in this file.
#
# The Supabase service-role key, the database URLs, and the inference key are
# backend secrets. They must never be added here under any name, prefixed or
# not — CI asserts their absence from the frontend environment and the built
# bundle (design.md decision 19).
#############################################################################

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public client key (the anon key, or its publishable-key equivalent).
# Public by design: it carries no privilege beyond what Row Level Security and
# Supabase Auth allow an anonymous or signed-in caller to do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Weathra backend base URL. Changing it retargets the frontend with no code
# change, so the two applications can sit on different origins or later behind
# one domain.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
