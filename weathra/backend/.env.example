#############################################################################
# Weathra backend configuration
#
# Copy to backend/.env and fill in. Every variable the backend reads appears
# here; nothing outside weathra/config.py reads the environment.
#
# Classification (design.md decision 19):
#   [required] must be set for the backend to start
#   [secret]   server-side only — never exposed to the browser, never
#              NEXT_PUBLIC_-prefixed, held in CI/Cloud Run secret storage
#   [behavior] tuning with a documented default; safe to omit
#
# The backend starts and serves every public capability with no inference
# credential set. Only the agent paths (/ask, /stream) degrade.
#############################################################################

# --------------------------------------------------------------------- runtime

# request_serving | privileged
#   request_serving — the API and stream processes. Uses DATABASE_URL under the
#                     restricted role so Row Level Security applies. Setting
#                     SUPABASE_SERVICE_ROLE_KEY in this mode refuses to start.
#   privileged      — migrations, the retention routine, and evaluation
#                     test-user provisioning only.
WEATHRA_RUNTIME_MODE=request_serving
WEATHRA_ENVIRONMENT=development
LOG_LEVEL=INFO
API_VERSION_PREFIX=/api/v1
# Explicit frontend origins, comma-separated. A wildcard is refused.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------- identity (Supabase Auth)

# [required] Supabase project URL. Issuer and key-set URLs derive from it.
SUPABASE_URL=https://your-project.supabase.co
# Override only when the issuer differs from <SUPABASE_URL>/auth/v1.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Override only when the key set is not at the derived well-known path.
SUPABASE_JWKS_URL=
# Signing-key cache lifetime in seconds. Rotation is picked up within it with
# no redeploy; an unknown key id refetches immediately regardless.
SUPABASE_JWKS_CACHE_TTL=600
# Clock-skew allowance on expiry, in seconds.
SUPABASE_JWT_LEEWAY_SECONDS=30
# [secret] Bypasses every Row Level Security policy. Permitted only when
# WEATHRA_RUNTIME_MODE=privileged. Leave empty for the API.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- persistence

# [secret] Request-serving connection. Authenticates as `weathra_api` (the
# login role migration 0003 creates), then assumes DATABASE_RESTRICTED_ROLE per
# transaction so Row Level Security applies. Not `weathra_request`: NOLOGIN.
# Supabase pooler in SESSION mode (5432), not 6543. Password provisioned
# separately; see docs/deployment.md.
DATABASE_URL=postgresql+asyncpg://weathra_api.PROJECT_REF:password@REGION.pooler.supabase.com:5432/postgres
# [secret] Privileged connection. Migrations and administrative routines only.
# Authenticates as the owner, on the direct connection rather than the pooler.
DATABASE_URL_PRIVILEGED=postgresql+asyncpg://postgres:password@host:5432/postgres
# Deliberately small: Postgres connection limits bind before app throughput.
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=2
# Role a request-scoped session assumes so RLS policies apply to backend queries.
DATABASE_RESTRICTED_ROLE=weathra_request

# ------------------------------------------------------------------- inference

LLM_PROVIDER=openrouter
# Any OpenRouter model id. Configuration, never architecture.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# [secret] Absent by design in every offline path. Only /ask and /stream need it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Bounded retries when a routing plan fails schema validation before the
# deterministic fallback router takes over.
LLM_JSON_MAX_ATTEMPTS=3
# Ceiling on honouring a gateway 429's Retry-After. A stated delay beyond this stops the retry
# rather than waiting: bounded patience, never an unbounded sleep.
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=30.0

# How long a process serves the model catalog, policy and plan snapshot before refreshing it.
# This is the documented staleness window: an administrator disabling a model may see it serve
# for up to this long on an instance that has not refreshed. Zero reads the database every time.
MODEL_CATALOG_CACHE_TTL_SECONDS=60

# Development only, and refused outright in a deployed environment: every call would use LLM_MODEL
# regardless of the caller's plan, leaving entitlement reported but not enforced.
LLM_SINGLE_MODEL_MODE=false
# How many models one call role may attempt before giving up, counting the first. Failover is for
# infrastructure failure — a withdrawn model, a gateway error, a timeout — and never for a
# judgement about output quality.
LLM_FAILOVER_MAX_MODELS=2

# How long raw language model usage events are kept. They carry per-call metadata and no
# conversation content, so this is about storage and relevance rather than disclosure.
LLM_USAGE_RETENTION_DAYS=90

# Whether plan allowances are enforced. On by default, including locally, so the development path
# is the deployed path; a suite that turns it off is exercising something other than the gate.
QUOTA_ENABLED=true
# The zone the calendar day and calendar month boundaries of an allowance window are computed in.
# Named rather than taken from the server's local time: a boundary that depended on where the
# process happened to run would only be noticed when two instances disagreed about who was over.
QUOTA_WINDOW_TIMEZONE=UTC

# ------------------------------------------------------------ weather providers

DEFAULT_WEATHER_PROVIDER=open-meteo
DEFAULT_GEOCODER=open-meteo
# metric | imperial
DEFAULT_UNIT_SYSTEM=metric
DEFAULT_FORECAST_DAYS=7
MINIMUM_HOURLY_HOURS=48
HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_SECONDS=0.25

# --------------------------------------------------------------------- caching

CACHE_CURRENT_TTL_SECONDS=900
CACHE_FORECAST_TTL_SECONDS=3600
# Past weather does not change, so historical entries outlive forecast ones.
CACHE_HISTORY_TTL_SECONDS=604800
CACHE_GEOCODING_TTL_SECONDS=604800
CACHE_MAX_ENTRIES=2048

# ---------------------------------------------------------------------- agents

AGENT_MAX_STEPS=24
# Set below the Supabase access-token lifetime so a stream cannot outlive its
# token, and below the platform request timeout so this budget terminates a run.
AGENT_WALL_CLOCK_BUDGET_SECONDS=120
COMPARISON_MAX_LOCATIONS=8

# ------------------------------------------------------------------------- MCP

# in-process | http
MCP_TRANSPORT=in-process
MCP_SERVER_ADDRESS=http://127.0.0.1:8000/mcp
MCP_TIMEOUT_SECONDS=30
MCP_ENABLED_TOOLS=geocode_location,weather_current,weather_forecast,weather_history,weather_compare,weather_statistics,weather_anomaly

# ------------------------------------------------------------------------- RAG

# Changing the model or dimension requires re-ingesting the corpus; a mismatch
# against the stored index is refused rather than silently compared.
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RAG_TOP_K=4
# Minimum cosine similarity. Below it, nothing is returned at all.
RAG_RELEVANCE_THRESHOLD=0.35
RAG_CHUNK_MAX_TOKENS=320
RAG_CHUNK_OVERLAP_TOKENS=48
VECTOR_STORE=pgvector

# ------------------------------------------------------------ memory and retention

THREAD_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=90
SAVED_LOCATIONS_LIMIT=25

# ---------------------------------------------------------------- evaluation integrity
#
# A live evaluation run must only report model-quality metrics when the configured model actually
# answered. These two settings are how that is enforced and how a free tier is paced.

# Proportion of a live run's cases the configured model must have served for the run to be scored
# as model quality at all. Below it the run is classified a provider failure, its metrics are not
# presented as the model's, and no threshold verdict is reported. 1.0 because two gating
# thresholds are 100%, and a 100% gate over a basis silently shrunk by quarantine is a weaker
# claim wearing the same number.
EVALUATION_MIN_SERVED_RATE=1.0
# Minimum wall-clock spacing between evaluation cases in live mode. A property of how the harness
# drives the API, never of the product: the dataset's 40 cases carry 46 turns and about 92 gateway
# calls, which at 2s spacing exceeds a 20-request-per-minute free-tier ceiling whenever the model
# answers in under ~2.5s. 5s holds the run under that ceiling at any plausible latency.
EVALUATION_LLM_MIN_INTERVAL_SECONDS=5.0

# ---------------------------------------------------------------- not variables
#
# Two things people look for here and will not find, on purpose.
#
# **The design tool (Visily.ai).** It is a design-time tool: it produces the
# UI/UX artifacts and the shared design system recorded under `docs/design/`,
# and no Weathra process ever calls it. The same was true of UXPilot, the
# earlier exploration whose approved design direction Visily carries forward.
# Neither is part of the runtime LLM/provider layer — that layer is OpenRouter
# alone, above — so there is no `VISILY_API_KEY`, no `UXPILOT_API_KEY` and no
# other design-tool variable in either application. If a design-tool key is
# ever needed it belongs to whoever runs the design tool, not to a deployed
# Weathra process.
#
# **Production secrets.** Nothing in this table is filled in from a file in
# production. The four backend secrets live in server-side deployment secret
# storage — Google Cloud Secret Manager, surfaced to the service as Cloud Run
# environment secrets, plus GitHub Actions secrets for the privileged jobs — and
# are injected as environment variables at start. A real value never enters Git:
# `backend/.env` is git-ignored, this file carries placeholders only, and CI
# holds no credential at all. `docs/deployment.md` records which secret lives
# where.
#
# To see which gateway models the configured account can use — free tier,
# tool-calling support, context length — run, from `backend/`:
#
#     python scripts/list_openrouter_models.py --free --tools
#
# It reads OPENROUTER_API_KEY from this environment and never prints it.
