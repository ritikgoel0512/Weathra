            ],
            "location_source": "request"
          }
        },
        {
          "question": "Which one is warmer tomorrow?",
          "expected_resolution": {
            "locations": [
              "Berlin",
              "Munich"
            ],
            "location_source": "thread"
          },
          "expected_answer_characteristics": [
            "berlin",
            "munich"
          ]
        }
      ],
      "expected_agents": [
        "forecast"
      ]
    },
